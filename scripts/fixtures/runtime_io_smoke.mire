extern fn pal_time_monotonic_ns: () :i64 lib "c"
extern fn rt_time_elapsed_ms_str: (start_ns :i64) :str lib "c"
extern fn rt_io_available: () :i64 lib "c"
extern fn rt_io_is_tty: () :i64 lib "c"

pub fn main: () :i32 {
    if rt_io_available() != 1 { return 2 :i32 }
    if rt_io_is_tty() != 0 { return 3 :i32 }
    set start_ns = pal_time_monotonic_ns()
    set elapsed_ms = rt_time_elapsed_ms_str(start_ns)
    set input = ireru("Input: ")
    dasu(input)
    dasu(elapsed_ms)
    return 0 :i32
}
