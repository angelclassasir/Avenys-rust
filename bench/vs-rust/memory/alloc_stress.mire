load mire::vec

pub fn main: () :i32 {
    set acc = 0 :i64 mut
    set outer = 0 :i64 mut
    while outer < 1000 {
        set v = [] :vec[i64] mut
        set i = 0 :i64 mut
        while i < 1000 {
            set v = vec::push::i64(v, outer * 1000 + i)
            set i += 1
        }
        set inner = 0 :i64 mut
        while inner < vec::len(v) {
            set acc = (acc + vec::get::i64(v, inner)) % 1000003
            set inner += 1
        }
        set outer += 1
    }
    dasu(str(acc))
    return 0 :i32
}