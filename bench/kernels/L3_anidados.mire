// L3: bucles anidados 2 niveles. Dificultad: media.
pub fn main: () :i32 {
    set acc = SEED_OPACA mut
    set i = 0 :i64 mut
    while i < 8000 {
        set j = 0 :i64 mut
        while j < 8000 {
            set acc += (i ^ j) % 11
            set j += 1
        }
        set i += 1
    }
    dasu(str(acc))
    return 0 :i32
}
