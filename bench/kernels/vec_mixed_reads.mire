// L5: mixed reads over one resident vector. Difficulty: medium.
// Un solo vector de 4096 elementos, recorrido muchas veces mezclando len, get,
// first y last. Los indices barren el rango completo para que ninguna lectura
// se pueda cachear entre vueltas.
load mire::vec

pub fn main: () :i32 {
    set seed = SEED_OPACA mut
    set v = [] :vec[i64] mut
    set k = 0 :i64 mut
    while k < 4096 {
        set v = vec::push::i64(v k * 5 + 1)
        set k += 1
    }
    set j = 0 :i64 mut
    while j < 12000000 {
        set idx = (j * 4093) % 4096
        set seed = (seed + vec::get::i64(v, idx) + vec::len(v)) % 1000003
        set j += 1
    }
    set seed = (seed + vec::first::i64(v) + vec::last::i64(v)) % 1000003
    dasu(str(seed))
    return 0 :i32
}