// L2: indexed reads over a dynamic list. Difficulty: easy.
// 2000 elementos x 4M pasadas. El acumulador entra de vuelta, asi que la
// pasada no se puede transformar en una reduccion de fuerza.
load mire::vec

pub fn main: () :i32 {
    set v = [] :vec[i64] mut
    set i = 0 :i64 mut
    while i < 2000 {
        set v = vec::push::i64(v i * 3)
        set i += 1
    }
    set acc = SEED_OPACA mut
    set j = 0 :i64 mut
    while j < 4000000 {
        set acc = acc % 1000003 + vec::get::i64(v, (j % 2000))
        set j += 1
    }
    dasu(str(acc))
    return 0 :i32
}
