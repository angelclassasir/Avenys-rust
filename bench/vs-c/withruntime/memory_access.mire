// C5: memory access patterns -- sequential vs random access. Difficulty: medium.
load mire::vec

pub fn main: () :i32 {
    set v = vec::with::capacity::i64(10000) mut
    set i = 0 :i64 mut
    while i < 10000 {
        set v = vec::push::i64(v i)
        set i += 1
    }
    set acc = 0 :i64 mut
    set i = 0 :i64 mut
    while i < 100000 {
        set idx = (i * 12345) % 10000
        set acc += vec::get::i64(v, idx)
        set i += 1
    }
    dasu(str(acc))
    return 0 :i32
}