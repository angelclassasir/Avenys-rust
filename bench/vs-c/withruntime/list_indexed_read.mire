load mire::vec

pub fn main: () :i32 {
    set v = [] :vec[i64] mut
    set i = 0 :i64 mut
    while i < 2000 {
        set v = vec::push::i64(v i * 3)
        set i += 1
    }
    set acc = 0 :i64 mut
    set i = 0 :i64 mut
    while i < 2000 {
        set acc = (acc + vec::get::i64(v i)) % 1000003
        set i += 1
    }
    dasu(str(acc))
    return 0 :i32
}