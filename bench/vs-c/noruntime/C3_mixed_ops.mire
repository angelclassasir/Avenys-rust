/*
 * VS-C No-Runtime: Mixed Integer/Float Operations
 * Direct glibc, no Mire runtime
 */
pub fn main: () :i64 {
    set i = 0 :i64 mut
    set acc = 0 :i64 mut
    set f = 1.5 :f64 mut
    while i < 5000000 {
        set acc = acc + i * 2
        set f = f * 1.0000001 + (i % 7 :f64)
        if i % 1000 == 0 { set f = f / 1.0000001 }
        set i += 1
    }
    return acc + (f :i64)
}