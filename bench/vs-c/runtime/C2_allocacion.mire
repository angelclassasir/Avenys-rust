load mire::vec

pub fn main: () :i64 {
    set n = 8000000 :i64
    set i = 0 :i64 mut
    set acc = 0 :i64 mut
    while i < n {
        set v = vec::with::capacity::i64(8) mut
        set j = 0 :i64 mut
        while j < 8 {
            set val = j + i
            set v = vec::push::i64(v val)
            set j += 1
        }
        set acc = (acc + vec::len(v) + vec::get::i64(v, 0)) % 1000003
        set i += 1
    }
    return acc
}
